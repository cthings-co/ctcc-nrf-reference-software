diff --git a/boards/ct/ctcc/ctcc_nrf9151_common.dtsi b/boards/ct/ctcc/ctcc_nrf9151_common.dtsi
new file mode 100644
index 00000000000..a9282e8ec0d
--- /dev/null
+++ b/boards/ct/ctcc/ctcc_nrf9151_common.dtsi
@@ -0,0 +1,95 @@
+/*
+ * Copyright (c) 2024 CTHINGS.CO
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "ctcc_nrf9151-pinctrl.dtsi"
+#include <zephyr/dt-bindings/input/input-event-codes.h>
+
+/ {
+	model = "CTHINGS.CO Connectivity Card nRF9151";
+	compatible = "ct,ctcc-nrf9151";
+
+	chosen {
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+		zephyr,uart-mcumgr = &uart0;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led1: led_1 {
+			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
+			label = "LED 1";
+		};
+
+		led2: led_2 {
+			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
+			label = "LED 2";
+		};
+	};
+
+	ctcc_wdisable: wdisable {
+		compatible = "ct,ctcc-wdisable";
+		status = "disabled";
+		gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+	};
+
+	aliases {
+		led0 = &led1;
+		led1 = &led2;
+		mcuboot-led0 = &led1;
+		watchdog0 = &wdt0;
+		spi-flash0 = &mx25r6435;
+	};
+};
+
+&gpiote {
+	status = "okay";
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+	current-speed = <115200>;
+	pinctrl-0 = <&uart0_default>;
+	pinctrl-1 = <&uart0_sleep>;
+	pinctrl-names = "default", "sleep";
+};
+
+&spi3 {
+	compatible = "nordic,nrf-spim";
+	status = "okay";
+	cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&spi3_default>;
+	pinctrl-1 = <&spi3_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	mx25r6435: mx25r6435fm2il0@0 {
+		compatible = "jedec,spi-nor";
+		status = "okay";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+		size = <DT_SIZE_M(64)>;
+		has-dpd;
+		dpd-wakeup-sequence = <30000>, <20>, <30000>;
+		jedec-id = [c2 28 17];
+	};
+};
+
+/*
+ * Include the standard nRF91 flash layout. It provides equal-sized primary and
+ * secondary MCUboot slots (image-0 / image-1, 0x70000 each). Equal slots are
+ * accepted by every MCUboot swap algorithm - swap_move.c and swap_offset.c each
+ * allow equal and each wants its asymmetry in the opposite direction - so the
+ * memory-optimal "primary larger by one sector + swap-status" asymmetry is
+ * deliberately NOT applied here, and the TF-M secure / non-secure / modem
+ * partitioning stays identical to the Nordic reference. The cost is one sector
+ * (~4 KB) of maximum image size, which is negligible.
+ */
+#include <nordic/nrf91xx_partition.dtsi>
