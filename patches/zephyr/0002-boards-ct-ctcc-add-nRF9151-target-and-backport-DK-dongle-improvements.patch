diff --git a/boards/ct/ctcc/ctcc_nrf52840.dts b/boards/ct/ctcc/ctcc_nrf52840.dts
index aa408b0b2a3..ea85f4172d9 100644
--- a/boards/ct/ctcc/ctcc_nrf52840.dts
+++ b/boards/ct/ctcc/ctcc_nrf52840.dts
@@ -32,6 +32,12 @@
 		};
 	};
 
+	ctcc_wdisable: wdisable {
+		compatible = "ct,ctcc-wdisable";
+		status = "disabled";
+		gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
+	};
+
 	aliases {
 		led0 = &led1;
 		led1 = &led2;
@@ -41,27 +47,46 @@
 };
 
 &flash0 {
+	/*
+	 * Flash layout for MCUboot's swap upgrade algorithms. The primary (image-0)
+	 * and secondary (image-1) slots are EQUAL in size, which is the only ratio
+	 * every algorithm accepts: boot_slots_compatible() in mcuboot swap_move.c
+	 * takes primary == secondary or primary == secondary + 1, swap_offset.c
+	 * takes the mirror of that (secondary == primary + 1), and both refuse
+	 * anything else at runtime with "not a compatible amount of sectors". Both
+	 * slots are therefore 0x75000 (117 x 4 KB pages). Neither algorithm needs a
+	 * scratch partition. The previous layout here was 0x76000 / 0x74000, a
+	 * two-sector gap that both algorithms reject.
+	 *
+	 * The mode itself is not fixed by this file: under sysbuild it comes from
+	 * SB_CONFIG_MCUBOOT_MODE_*, and boot/zephyr/boards/ctcc_nrf52840.conf pins
+	 * CONFIG_BOOT_SWAP_USING_MOVE only for a standalone MCUboot build.
+	 */
 	partitions {
-		compatible = "fixed-partitions";
+		ranges;
 		#address-cells = <1>;
 		#size-cells = <1>;
 
 		boot_partition: partition@0 {
+			compatible = "zephyr,mapped-partition";
 			label = "mcuboot";
 			reg = <0x00000000 0x00012000>;
 		};
 
 		slot0_partition: partition@12000 {
+			compatible = "zephyr,mapped-partition";
 			label = "image-0";
-			reg = <0x00012000 0x00076000>;
+			reg = <0x00012000 0x00075000>;
 		};
 
-		slot1_partition: partition@88000 {
+		slot1_partition: partition@87000 {
+			compatible = "zephyr,mapped-partition";
 			label = "image-1";
-			reg = <0x00088000 0x00074000>;
+			reg = <0x00087000 0x00075000>;
 		};
 
 		storage_partition: partition@fc000 {
+			compatible = "zephyr,mapped-partition";
 			label = "storage";
 			reg = <0x000fc000 0x00004000>;
 		};
@@ -84,6 +109,10 @@
 	status = "okay";
 };
 
+&gpio1 {
+	status = "okay";
+};
+
 &ieee802154 {
 	status = "okay";
 };
diff --git a/boards/ct/ctcc/ctcc_nrf9151-pinctrl.dtsi b/boards/ct/ctcc/ctcc_nrf9151-pinctrl.dtsi
new file mode 100644
index 00000000000..a07800832ba
--- /dev/null
+++ b/boards/ct/ctcc/ctcc_nrf9151-pinctrl.dtsi
@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2024 CTHINGS.CO
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+&pinctrl {
+	uart0_default: uart0_default {
+		group1 {
+			psels = <NRF_PSEL(UART_TX, 0, 28)>,
+				<NRF_PSEL(UART_RTS, 0, 14)>;
+		};
+
+		group2 {
+			psels = <NRF_PSEL(UART_RX, 0, 29)>,
+				<NRF_PSEL(UART_CTS, 0, 15)>;
+		};
+	};
+
+	uart0_sleep: uart0_sleep {
+		group1 {
+			psels = <NRF_PSEL(UART_TX, 0, 28)>,
+				<NRF_PSEL(UART_RX, 0, 29)>,
+				<NRF_PSEL(UART_RTS, 0, 14)>,
+				<NRF_PSEL(UART_CTS, 0, 15)>;
+			low-power-enable;
+		};
+	};
+
+	spi3_default: spi3_default {
+		group1 {
+			psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
+				<NRF_PSEL(SPIM_MISO, 0, 5)>,
+				<NRF_PSEL(SPIM_MOSI, 0, 4)>;
+			nordic,drive-mode = <NRF_DRIVE_H0H1>;
+		};
+	};
+
+	spi3_sleep: spi3_sleep {
+		group1 {
+			psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
+				<NRF_PSEL(SPIM_MISO, 0, 5)>,
+				<NRF_PSEL(SPIM_MOSI, 0, 4)>;
+			low-power-enable;
+		};
+	};
+};
