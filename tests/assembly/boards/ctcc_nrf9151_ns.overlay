 *
 * Standalone build: relocate slot0 to flash origin.
 *
 * The board selects USE_DT_CODE_PARTITION for the /ns targets, so an image links
 * inside slot0 - correct when MCUboot loads it, wrong for this test, which has no
 * bootloader and must be startable by the boot ROM at 0x0. Move the whole group
 * rather than switching the mechanism off: `ranges` and the nested children keep
 * TF-M (slot0_s, +0) and the non-secure image (slot0_ns, +0x40000) consistent with
 * each other, which is what the secure/non-secure split needs.
 */

&slot0_partition {
	reg = <0x00000000 0x00070000>;
	ranges = <0x0 0x0 0x00070000>;
};
